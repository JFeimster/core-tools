{
  "project": {
    "name": "Core Tool Directory",
    "repo": "https://github.com/JFeimster/core-tools.git",
    "liveSite": "https://core-tools.vercel.app",
    "primaryBranch": "main",
    "workingBranch": "feature/tool-registry-architecture-overhaul",
    "lastReviewedAt": "2026-06-08"
  },
  "stack": {
    "framework": "Next.js 15.3.8 App Router",
    "language": "TypeScript",
    "styling": "Tailwind CSS",
    "deployment": "Vercel static export",
    "buildModel": "Static export with JSON-driven public data and file-based tool artifacts"
  },
  "routeInventory": {
    "appRoutes": [
      "/",
      "/tools",
      "/tools/[slug]",
      "/tools/[slug]/embed",
      "/brands",
      "/brands/[brand]",
      "/collections",
      "/collections/[slug]"
    ],
    "adminRoutes": [
      "/admin",
      "/admin/tool-builder",
      "/admin/collection-builder"
    ],
    "generatedRoutes": [
      "/tools.json"
    ]
  },
  "sourceOfTruthFiles": [
    "data/tools.json",
    "data/collections.json",
    "data/tag-taxonomy.json",
    "registries/funding-tools.registry.json",
    "registries/tool-artifacts.registry.json",
    "registries/registry-index.json"
  ],
  "generatedFiles": [
    "public/tools.json",
    "data/public-tool-index.json"
  ],
  "internalRegistryFiles": [
    "registries/funding-tools.registry.json",
    "registries/affiliate-offers.registry.json",
    "registries/tool-artifacts.registry.json",
    "registries/cta-routing.registry.json",
    "registries/compliance-rules.registry.json",
    "registries/brands.registry.json",
    "registries/collections.registry.json",
    "registries/personas.registry.json"
  ],
  "publicDataFiles": [
    "data/tools.json",
    "data/collections.json",
    "data/tag-taxonomy.json",
    "data/public-tool-index.json"
  ],
  "staticArtifactArchitecture": {
    "toolRoot": "tools/[slug]/",
    "requiredFiles": [
      "README.md",
      "tool.config.json",
      "landing/index.html",
      "landing/styles.css",
      "landing/script.js",
      "embed/index.html",
      "embed/styles.css",
      "embed/script.js",
      "assets/",
      "exports/"
    ],
    "legacyRootHtml": [
      "landing.html",
      "embed.html",
      "landing/index.html"
    ]
  },
  "toolArtifactPattern": "tools/[slug]/{README.md,tool.config.json,landing/,embed/,assets/,exports/}",
  "registryStrategy": "Internal registries track backlog, routing, compliance, artifacts, and monetization. Public app data only receives sanitized projections.",
  "privacyRules": [
    "Do not expose internal routing notes in public data.",
    "Do not expose affiliate partner names unless intentionally public.",
    "Do not expose provider underwriting logic in public projections.",
    "Mark generated files clearly and do not hand-author public/tools.json."
  ],
  "migrationNotes": [
    "Burn Rate Runway Extender now has a dedicated tool artifact folder.",
    "Root landing/embed HTML should be treated as deprecated legacy surfaces.",
    "Funding tools were promoted from internal registry backlog into public-safe tool records.",
    "Public tags were normalized toward canonical kebab-case while deprecated aliases remain mapped in taxonomy."
  ],
  "validationScripts": [
    "npm run validate:data",
    "npm run validate:registries",
    "npm run build"
  ],
  "recommendedNextFiles": [
    "docs/funding-tools-promotion-workflow.md",
    "registries/provider-routing.registry.json",
    "tools/rokfi-burn-rate-runway-extender/tool.config.json"
  ]
}
